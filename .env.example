# ─────────────────────────────────────────────────────────────
# Discord Music Bot — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# REQUIRED — your Discord bot token.
# (DISCORD_TOKEN and BOT_TOKEN are also accepted as fallbacks.)
TOKEN=your_discord_bot_token_here

# Dashboard recovery token for localhost/emergency access. Cloudflare Access-
# authenticated tunnel requests enter automatically. Use at least 24 random
# characters and never commit the real value.
ADMIN_TOKEN=

# HTTP port for the web dashboard (default: 8080).
# PORT=8080

# Host interface used to publish the dashboard port. Keep 0.0.0.0 only while
# initially testing; use 127.0.0.1 after Cloudflare Tunnel is healthy.
# DASHBOARD_BIND_ADDRESS=0.0.0.0

# Cloudflare Tunnel (recommended for the production dashboard). Create a
# remotely-managed tunnel, store its raw token here, and enable the profile.
# Never commit the real token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
# CLOUDFLARED_VERSION=latest

# Cloudflare Access JWT verification (recommended with the tunnel). Set both to
# have the dashboard verify the Access JWT signature, audience, issuer and expiry
# instead of trusting the Access headers. Find the AUD tag on the Access
# application's Overview page; the team domain is <team>.cloudflareaccess.com.
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Public "Report a bug" button. Create a free form at https://formspree.io,
# then paste the ID from its endpoint (https://formspree.io/f/<ID>). Reports
# are emailed to the Formspree account. Leave unset to hide the button.
# FORMSPREE_FORM_ID=

# Spotify track and album links. The bot reads song details from Spotify's Web
# API and plays the matching YouTube video (Spotify audio cannot be streamed).
# Create an app at https://developer.spotify.com/dashboard (the app owner needs
# Spotify Premium) and copy its Client ID and Client Secret. Playlist links are
# read from Spotify's public embed player and work without these.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Link behind the bot's purple "Streaming" status while music plays. Discord
# only shows the purple badge for a Twitch channel (https://www.twitch.tv/NAME)
# or a YouTube video (https://www.youtube.com/watch?v=ID). Never a song link:
# the status is visible in every server. Default: https://www.twitch.tv/discord
# PRESENCE_STREAM_URL=

# Dashboard memory gauge ceiling in MB (default: 2048).
# VM_MEMORY_MB=2048

# ─── YouTube anti-bot / authentication ───────────────────────
# Modern yt-dlp needs a supported JS runtime + PO tokens on datacenter IPs.
# The Docker image uses Node and runs the bgutil PO-token sidecar
# automatically — for the standard Docker Compose setup you need NOTHING here.

# PO-token provider URL. Defaults to the compose sidecar; only override if you
# run the provider elsewhere or on a different port.
# BGUTIL_BASE_URL=http://bgutil-provider:4416

# Keep the provider sidecar and yt-dlp plugin on the same release. The default
# is pinned by docker-compose.yml; change this only when intentionally upgrading.
# BGUTIL_VERSION=1.3.1

# Optional YouTube cookies — only needed for login-restricted videos.
# Option A: path to a Netscape-format cookies.txt (inside the container).
#   (YTDLP_COOKIES is accepted as an alias for YTDLP_COOKIES_PATH.)
# YTDLP_COOKIES_PATH=/app/data/cookies.txt
# Option B: base64-encoded cookies (handy when you can't mount a file).
# YTDLP_COOKIES_BASE64=

# How many YouTube lookups (yt-dlp) may run at once. More uses more CPU when
# many servers start songs together; 2 suits a small server.
# YTDLP_MAX_CONCURRENT=2

# Legacy manual PO token (expires in hours — prefer the auto-provider above).
# YTDLP_PO_TOKEN=
