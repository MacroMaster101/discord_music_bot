TOKEN=your_discord_bot_token_here
PREFIX=!

# YouTube authentication (recommended to avoid "bot verification" blocks)
# Option A: path to a Netscape-format cookies.txt file
# YTDLP_COOKIES_PATH=./cookies.txt
# Option B: base64-encoded cookies (useful for hosting platforms like Railway)
# YTDLP_COOKIES_BASE64=
# Option C: Proof-of-Origin token (advanced, see yt-dlp docs)
# YTDLP_PO_TOKEN=
